---
import dayjs from "dayjs";
import BaseLayout from "./baseLayout.astro";

export interface Props {
  frontmatter: {
    title: string;
    subtitle: string;
    description: string;
    pubDate: string;
    image: {
      src: string;
      width: number;
      height: number;
      format: "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "svg" | "avif";
    };
    link: string;
    source: string;
    tags: string[];
  };
}

const {
  frontmatter: { title, subtitle, description, pubDate, image, link, source },
} = Astro.props;

const formatedDate = dayjs(pubDate).format("MMMM DD, YYYY");
const projectLink = link || source;
const hasDistinctSource = Boolean(source && source !== projectLink);
const siteUrl = Astro.site ?? new URL("https://nstlopez.com");
const personId = new URL("#person", siteUrl).href;
const organizationId = new URL("#organization", siteUrl).href;
const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${Astro.url.href}#software`,
  name: title,
  description,
  url: projectLink || Astro.url.href,
  image: new URL(image.src, siteUrl).toString(),
  datePublished: new Date(pubDate).toISOString(),
  author: {
    "@type": "Person",
    "@id": personId,
    name: "Néstor López",
    url: siteUrl.toString(),
  },
  publisher: { "@id": organizationId },
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={image.src}
  jsonLd={[softwareJsonLd]}
>
  <header class="post-header">
    <h1>{title}</h1>
    <p class="subheading">{subtitle}</p>
    <time class="post-meta" datetime={dayjs(pubDate).format("YYYY-MM-DD")}
      >{formatedDate}</time
    >
  </header>
  <figure class="post-hero-image">
    <img src={image.src} alt={title} fetchpriority="high" loading="eager" />
  </figure>
  <article class="content">
    <div class="button-row">
      <a
        class="button"
        target="_blank"
        rel="noreferrer"
        href={projectLink}
        data-s:event="project_link_view"
        data-s:event-props={`title=${title}`}
      >
        View project
      </a>
      {
        hasDistinctSource && (
          <a
            class="button button-ghost"
            target="_blank"
            rel="noreferrer"
            href={source}
            data-s:event="project_source_view"
            data-s:event-props={`title=${title}`}
          >
            View source
          </a>
        )
      }
    </div>
    <slot />
  </article>
</BaseLayout>
