---
import dayjs from "dayjs";
import BaseLayout from "./baseLayout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: string;
    expectedReadTime: number;
    image: {
      src: string;
      width: number;
      height: number;
      format: "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "svg" | "avif";
    };
    revised_by?:
      | {
          name: string;
          link: string;
        }[]
      | undefined;
    tags: string[];
  };
}

const {
  frontmatter: {
    title,
    description,
    pubDate,
    expectedReadTime,
    image,
    revised_by,
  },
} = Astro.props;

const formatedDate = dayjs(pubDate).format("MMMM DD, YYYY");
const siteUrl = Astro.site ?? new URL("https://nstlopez.com");
const personId = new URL("#person", siteUrl).href;
const organizationId = new URL("#organization", siteUrl).href;
const webpageId = new URL("#webpage", Astro.url).href;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${Astro.url.href}#article`,
  headline: title,
  description,
  image: new URL(image.src, siteUrl).toString(),
  datePublished: new Date(pubDate).toISOString(),
  dateModified: new Date(pubDate).toISOString(),
  author: {
    "@type": "Person",
    "@id": personId,
    name: "Néstor López",
    url: siteUrl.toString(),
  },
  publisher: { "@id": organizationId },
  mainEntityOfPage: { "@id": webpageId },
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={image.src}
  jsonLd={[articleJsonLd]}
>
  <header class="post-header">
    <h1 transition:name={title}>{title}</h1>
    <span class="post-meta">
      <time datetime={dayjs(pubDate).format("YYYY-MM-DD")}>{formatedDate}</time>
      &middot; {`${expectedReadTime.toString()} min read`}
    </span>
    {
      revised_by ? (
        <span class="post-meta">
          Revised by{" "}
          {revised_by.map((r, index) => (
            <>
              <a href={r.link}>{r.name}</a>
              {index < revised_by.length - 1 ? ", " : ""}
            </>
          ))}
        </span>
      ) : null
    }
  </header>
  <figure class="post-hero-image">
    <img src={image.src} alt={title} fetchpriority="high" loading="eager" />
  </figure>
  <article class="content">
    <slot />
  </article>
  <div class="giscus comments"></div>
  <script>
    const theme = localStorage.getItem("theme") ?? "dark";
    const giscusTheme = theme === "dark" ? "dark" : "light";

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.setAttribute("data-repo", "Nsttt/my-portfolio");
    script.setAttribute("data-repo-id", "MDEwOlJlcG9zaXRvcnkyOTM4NTk0Mjk=");
    script.setAttribute("data-category", "Comments");
    script.setAttribute("data-category-id", "DIC_kwDOEYPwZc4CVJ8A");
    script.setAttribute("data-mapping", "pathname");
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "top");
    script.setAttribute("data-theme", giscusTheme);
    script.setAttribute("data-lang", "en");
    script.setAttribute("data-loading", "lazy");
    script.setAttribute("data-origin", window.location.origin);
    script.setAttribute("crossorigin", "anonymous");
    script.async = true;

    const giscusContainer = document.querySelector(".giscus");
    if (giscusContainer) {
      giscusContainer.appendChild(script);
    }

    // Listen for theme changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (
          mutation.type === "attributes" &&
          mutation.attributeName === "class"
        ) {
          const isDark = document.documentElement.classList.contains("dark");
          const newTheme = isDark ? "dark" : "light";

          // Update Giscus theme
          const iframe = document.querySelector(
            "iframe.giscus-frame",
          ) as HTMLIFrameElement;
          if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage(
              { giscus: { setConfig: { theme: newTheme } } },
              "https://giscus.app",
            );
          }
        }
      });
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  </script>
</BaseLayout>
