---
import dayjs from "dayjs";
import BaseLayout from "./baseLayout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: string;
    place: string;
    lang: string;
    mainImage?:
      | {
          src: string;
          width: number;
          height: number;
          format:
            | "png"
            | "jpg"
            | "jpeg"
            | "tiff"
            | "webp"
            | "gif"
            | "svg"
            | "avif";
        }
      | undefined;
    images?:
      | {
          src: string;
          width: number;
          height: number;
          format:
            | "png"
            | "jpg"
            | "jpeg"
            | "tiff"
            | "webp"
            | "gif"
            | "svg"
            | "avif";
        }[]
      | undefined;
  };
}

const {
  frontmatter: { title, description, pubDate, images, mainImage, place, lang },
} = Astro.props;

const formatedDate = dayjs(pubDate).format("MMMM DD, YYYY");
const siteUrl = Astro.site ?? new URL("https://nstlopez.com");
const personId = new URL("#person", siteUrl).href;
const organizationId = new URL("#organization", siteUrl).href;
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": `${Astro.url.href}#event`,
  name: title,
  description,
  startDate: new Date(pubDate).toISOString(),
  inLanguage: lang,
  location: {
    "@type": "Place",
    name: place,
  },
  performer: {
    "@type": "Person",
    "@id": personId,
    name: "Néstor López",
    url: siteUrl.toString(),
  },
  organizer: { "@id": organizationId },
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={mainImage ? mainImage.src : undefined}
  jsonLd={[eventJsonLd]}
>
  <header class="post-header">
    <h1>{title}</h1>
    <p class="subheading">{description}</p>
    <span class="post-meta">
      {place} &middot; {lang} &middot;
      <time datetime={dayjs(pubDate).format("YYYY-MM-DD")}>{formatedDate}</time>
    </span>
  </header>
  <article class="content">
    <slot />
    {
      mainImage && (
        <img
          src={mainImage.src}
          alt={title}
          fetchpriority="high"
          loading="eager"
        />
      )
    }
    {images && images.map((image) => <img src={image.src} alt={title} />)}
  </article>
</BaseLayout>
