---
import { getCollection } from "astro:content";
import Search from "../components/search";
import Timeline from "../components/timeline.astro";
import BaseLayout from "../layouts/baseLayout.astro";

const categoryLabels = {
  conference: "Conference",
  meetup: "Meetup",
  workshop: "Workshop",
  podcast: "Podcast / Radio",
  campus: "Campus Session",
};

const talks = (await getCollection("talks")).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);
---

<BaseLayout title="Talks" description="All the talks and Workshops I've given.">
  <div class="page">
    <h1 class="page-title">Talks</h1>

    <Search
      client:load
      placeholder="Search talks..."
      itemClass="talk-item"
      containerId="talks-container"
      toolName="filter_talks"
      toolDescription="Filter visible talks, workshops, podcasts, and speaking appearances."
    />

    <Timeline
      id="talks-container"
      itemClass="talk-item"
      items={talks.map((talk) => ({
        href: `/talks/${talk.id}/`,
        title: talk.data.title,
        date: talk.data.pubDate,
        meta: [
          categoryLabels[talk.data.category],
          talk.data.place,
          talk.data.lang,
        ].join(" · "),
        searchData: {
          title: talk.data.title.toLowerCase(),
          description: talk.data.description.toLowerCase(),
          place: talk.data.place.toLowerCase(),
          lang: talk.data.lang.toLowerCase(),
          category: talk.data.category.toLowerCase(),
          tags: talk.data.tags.join(" ").toLowerCase(),
        },
      }))}
    />

    <p id="no-results" class="no-results hidden">No results found</p>
  </div>
</BaseLayout>
