---
import { getCollection } from "astro:content";
import Search from "../components/search";
import Timeline from "../components/timeline.astro";
import BaseLayout from "../layouts/baseLayout.astro";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
  );
---

<BaseLayout title="Blog" description="All my blog posts.">
  <div class="page">
    <h1 class="page-title">Blog</h1>

    <Search
      client:load
      placeholder="Search posts..."
      itemClass="post-item"
      containerId="posts-container"
      toolName="filter_blog_posts"
      toolDescription="Filter visible blog posts by title, description, and tags."
    />

    <Timeline
      id="posts-container"
      itemClass="post-item"
      items={posts.map((post) => ({
        href: `/blog/${post.id}/`,
        title: post.data.title,
        date: post.data.pubDate,
        meta: `${post.data.expectedReadTime} min read`,
        searchData: {
          title: post.data.title.toLowerCase(),
          description: post.data.description.toLowerCase(),
          tags: post.data.tags.join(" ").toLowerCase(),
        },
      }))}
    />

    <p id="no-results" class="no-results hidden">No results found</p>
  </div>
</BaseLayout>
