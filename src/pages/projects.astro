---
import { getCollection } from "astro:content";
import ImageCard from "../components/imageCard.astro";
import Search from "../components/search";
import BaseLayout from "../layouts/baseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);
---

<BaseLayout title="Projects" description="All my projects.">
  <div class="page">
    <h1 class="page-title">Projects</h1>

    <Search
      client:load
      placeholder="Search projects..."
      itemClass="project-item"
      containerId="projects-container"
      toolName="filter_projects"
      toolDescription="Filter visible software projects by title, description, and tags."
    />

    <ul id="projects-container" class="card-grid" role="list">
      {
        projects.map((project) => (
          <li
            class="project-item"
            data-title={project.data.title.toLowerCase()}
            data-description={project.data.description.toLowerCase()}
            data-tags={project.data.tags.join(" ").toLowerCase()}
          >
            <ImageCard
              href={`/projects/${project.id}/`}
              title={project.data.title}
              image={project.data.image}
              meta={project.data.subtitle}
            />
          </li>
        ))
      }
    </ul>

    <p id="no-results" class="no-results hidden">No results found</p>
  </div>
</BaseLayout>
