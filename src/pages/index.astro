---
import { getCollection } from "astro:content";
import GithubRepos from "../components/githubRepos.astro";
import ImageCard from "../components/imageCard.astro";
import { socials } from "../data/socials";
import BaseLayout from "../layouts/baseLayout.astro";

const byNewest = (a: { data: { pubDate: string } }, b: typeof a) =>
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf();
const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(byNewest)
  .slice(0, 4);
const talks = (await getCollection("talks")).sort(byNewest).slice(0, 4);
const projects = (await getCollection("projects")).sort(byNewest).slice(0, 4);
const pinnedRepos = [
  {
    name: "module-federation/core",
    description:
      "Share code and resources across multiple JavaScript applications.",
    language: "JavaScript",
    stars: 2674,
  },
  {
    name: "web-infra-dev/rspack",
    description:
      "Fast Rust-based bundler for the web with a modernized webpack API.",
    language: "Rust",
    stars: 12964,
  },
  {
    name: "vitejs/vite",
    description: "Next generation frontend tooling. It's fast!",
    language: "TypeScript",
    stars: 83635,
  },
  {
    name: "module-federation/tanstack",
    description: "Module Federation plugin for TanStack Start.",
    language: "TypeScript",
    stars: 25,
  },
  {
    name: "module-federation/nuxt",
    description: "Module Federation plugin for Nuxt.",
    language: "TypeScript",
    stars: 23,
  },
  {
    name: "module-federation/astro",
    description: "Module Federation on Astro components and runtime.",
    language: "TypeScript",
    stars: 8,
  },
];
const iconNav: {
  href: string;
  label: string;
  icon: string;
  event?: string;
  filled?: boolean;
}[] = [
  {
    href: "/blog",
    label: "Blog",
    icon: "M6 2h9l5 5v15H6zM14 2v6h6M9 13h8M9 17h8",
  },
  ...socials.map((social) => ({ ...social, filled: true })),
  {
    href: "/rss.xml",
    label: "RSS",
    icon: "M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 19h.01",
  },
];
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${Astro.site}#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "Who is Néstor López?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Néstor López is a software engineer writing about software architecture, distributed systems, Module Federation, edge-native deployments, developer tooling, and infrastructure.",
      },
    },
    {
      "@type": "Question",
      name: "What topics does Néstor López write and speak about?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "He writes and speaks about Module Federation, microfrontends, distributed systems, edge infrastructure, TypeScript, developer tooling, IoT, and systems design.",
      },
    },
    {
      "@type": "Question",
      name: "How can I contact Néstor López?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You can contact Néstor López through the booking link on nstlopez.com, X at @nstlopez, GitHub at nsttt, or Bluesky at nst.blue.",
      },
    },
  ],
};
---

<BaseLayout
  title="Néstor's Blog"
  description="Writing about software architecture, distributed systems, Module Federation, and developer tooling."
  jsonLd={[faqJsonLd]}
  home
>
  <article class="homepage">
    <nav class="icon-nav" aria-label="Explore the site">
      <ul role="list">
        {
          iconNav.map((item) => (
            <li>
              <a
                href={item.href}
                onclick={
                  item.event
                    ? `window.umami?.track('${item.event}', { type: 'social' })`
                    : undefined
                }
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  {...(item.filled
                    ? { fill: "currentColor" }
                    : {
                        fill: "none",
                        stroke: "currentColor",
                        "stroke-width": "2",
                        "stroke-linecap": "round",
                        "stroke-linejoin": "round",
                      })}
                >
                  <path d={item.icon} />
                </svg>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="intro divided">
      <header>
        <h1 class="greeting">
          Hi, I'm Néstor
          <img
            class="pixel-art"
            src="/images/suica-sprite.gif"
            alt=""
            width="84"
            height="70"
            loading="eager"
          />
        </h1>
      </header>
      <p>
        Software engineer from Spain 🇪🇸 building typesafe, scalable systems. I
        work on Module Federation and edge infrastructure at <a
          href="https://zephyr-cloud.io/"
          target="_blank">Zephyr Cloud</a
        >.
      </p>
      <form
        class="sr-only"
        action="/blog"
        method="get"
        role="search"
        aria-label="Search blog posts"
        tool-name="search_blog_posts"
        tool-description="Search Néstor López's technical blog posts by keyword."
      >
        <label class="sr-only" for="homepage-search">Search blog posts</label>
        <input
          id="homepage-search"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Search blog posts..."
          tool-param-description="Keyword query for blog post titles, descriptions, and tags."
        />
        <button type="submit">Search</button>
      </form>
      <p>Off the clock: homelab tinkering and arcade games.</p>
      <img
        class="portrait"
        src="/images/profile-320.webp"
        alt="Néstor López"
        width="160"
        height="160"
        loading="eager"
      />
    </section>

    <section class="divided">
      <header>
        <h2>Writing</h2>
      </header>
      <p>
        Long-form posts about software architecture, distributed systems,
        developer tooling, and the occasional personal detour.
      </p>
      <ul class="card-grid" role="list">
        {
          posts.map((post) => (
            <li>
              <ImageCard
                href={`/blog/${post.id}/`}
                title={post.data.title}
                image={post.data.image}
                meta={`${post.data.expectedReadTime} min read`}
                eventName="blog_post_click"
              />
            </li>
          ))
        }
      </ul>
      <p class="see-all">
        <a href="/blog" data-s:event="view_all_posts">See all posts</a>
      </p>
    </section>

    <section class="divided">
      <header>
        <h2>Talks</h2>
      </header>
      <p>
        I do conference talks and workshops about Module Federation,
        infrastructure, OSS tools, IoT, and systems design.
      </p>
      <ul class="card-grid" role="list">
        {
          talks.map((talk) => (
            <li>
              <ImageCard
                href={`/talks/${talk.id}/`}
                title={talk.data.title}
                image={talk.data.mainImage ?? talk.data.images?.[0]}
                placeholder={talk.data.place.split(",")[0]}
                meta={talk.data.place}
                eventName="talk_click"
              />
            </li>
          ))
        }
      </ul>
      <p class="see-all">
        <a href="/talks" data-s:event="view_all_talks">See all talks</a>
      </p>
    </section>

    <section class="divided">
      <header>
        <h2>Projects</h2>
      </header>
      <p>
        Side projects, experiments, and the occasional terrible idea that turned
        out to work.
      </p>
      <ul class="card-grid" role="list">
        {
          projects.map((project) => (
            <li>
              <ImageCard
                href={`/projects/${project.id}/`}
                title={project.data.title}
                image={project.data.image}
                meta={project.data.subtitle}
                eventName="project_click"
              />
            </li>
          ))
        }
      </ul>
      <p class="see-all">
        <a href="/projects" data-s:event="view_all_projects">See all projects</a
        >
      </p>
    </section>

    <section class="divided">
      <header>
        <h2>Open source</h2>
      </header>
      <p>
        Most of my open source time goes into the bundler ecosystem. These are
        the repositories I spend it in; the rest lives on <a
          href="https://github.com/nsttt"
          data-s:event="view_github">GitHub</a
        >.
      </p>
      <GithubRepos repos={pinnedRepos} />
    </section>

    <section class="divided intro">
      <header>
        <h2>Let's talk</h2>
      </header>
      <p>
        I help people and teams through consulting and mentoring. If you want to
        chat about architecture, infrastructure, or anything in between, grab a
        slot.
      </p>
      <p class="see-all button-row">
        <a
          class="button"
          href="https://cal.com/nstlopez"
          target="_blank"
          rel="noopener noreferrer">Book a call</a
        >
      </p>
    </section>
  </article>
</BaseLayout>
