---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import dayjs from "dayjs";

export interface TimelineItem {
  href: string;
  title: string;
  date: string | Date;
  meta?: string | undefined;
  image?: ImageMetadata | undefined;
  /** Shown in place of the image when there is none, e.g. an event name. */
  placeholder?: string | undefined;
  searchData?: Record<string, string> | undefined;
}

interface Props {
  id: string;
  itemClass: string;
  items: TimelineItem[];
}

const { id, itemClass, items } = Astro.props;

const years = new Map<number, TimelineItem[]>();
for (const item of items) {
  const year = dayjs(item.date).year();
  years.set(year, [...(years.get(year) ?? []), item]);
}

const toDataAttributes = (data: Record<string, string> = {}) =>
  Object.fromEntries(
    Object.entries(data).map(([key, value]) => [`data-${key}`, value]),
  );
---

<div id={id} class="timeline">
  {
    [...years].map(([year, yearItems]) => (
      <section
        class="timeline-year divided"
        aria-labelledby={`${id}-${year}`}
        data-search-group
      >
        <h2 id={`${id}-${year}`}>{year}</h2>
        <ul class="timeline-list" role="list">
          {yearItems.map((item) => (
            <li class={itemClass} {...toDataAttributes(item.searchData)}>
              {/* The title link carries the name; this one is a pointer
                  shortcut, so it stays out of the tab order. */}
              <a
                class="timeline-thumb"
                href={item.href}
                tabindex="-1"
                aria-hidden="true"
              >
                {item.image ? (
                  <Image src={item.image} alt="" width={240} loading="lazy" />
                ) : (
                  <span class="timeline-placeholder">
                    {item.placeholder ?? item.title}
                  </span>
                )}
              </a>
              <time datetime={dayjs(item.date).format("YYYY-MM-DD")}>
                {dayjs(item.date).format("MMMM D")}
              </time>
              <span class="timeline-text">
                <a rel="prefetch" href={item.href}>
                  {item.title}
                </a>
                {item.meta && <span class="timeline-meta">{item.meta}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
