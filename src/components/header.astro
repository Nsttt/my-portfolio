---
import { socials } from "../data/socials";
import ToggleButton from "./toggleButton";

const pathname = Astro.url.pathname;

const links = [{ href: "/blog", label: "Blog" }];

const isCurrent = (href: string) => pathname.startsWith(href);
---

<nav class="topnav" aria-label="Site navigation">
  <a class="topnav-home" href="/">
    <img
      class="pixel-art"
      src="/images/suica-sprite.gif"
      alt=""
      width="42"
      height="35"
      loading="eager"
    />
    <span>Néstor López</span>
  </a>
  <div class="topnav-links">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
  <div class="topnav-social">
    {
      socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.label}
          title={social.label}
          onclick={`window.umami?.track('${social.event}', { type: 'social' })`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={social.icon} />
          </svg>
        </a>
      ))
    }
  </div>
  <ToggleButton client:only="solid-js" />
</nav>
