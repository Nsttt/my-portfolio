---
import {
  POSTHOG_API_HOST,
  POSTHOG_PROJECT_TOKEN,
  POSTHOG_UI_HOST,
} from "../utils/posthog";

// Local visits are not real traffic, so PostHog only runs in production
// builds.
const enabled = import.meta.env.PROD;
const token = POSTHOG_PROJECT_TOKEN;
const options = {
  api_host: POSTHOG_API_HOST,
  // Needed behind a proxy so links point back to PostHog itself.
  ui_host: POSTHOG_UI_HOST,
  defaults: "2026-05-30",
  person_profiles: "identified_only",
  // ClientRouter navigations are history changes, not page loads.
  capture_pageview: "history_change",
};
---

<script is:inline define:vars={{ enabled, token, options }}>
  // @ts-nocheck -- `checkJs` would otherwise type-check PostHog's minified loader.
  // ClientRouter can re-run inline scripts; initialising twice overflows the
  // stack.
  if (enabled && !window.__posthog_initialized) {
    window.__posthog_initialized = true;
