---
import { POSTHOG_PROXY_PATH, posthogRegion } from "../utils/posthog";

const token = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN;
const host = import.meta.env.PUBLIC_POSTHOG_HOST;
const region = posthogRegion(host);

const missing = !token
  ? "PUBLIC_POSTHOG_PROJECT_TOKEN"
  : !region
    ? "PUBLIC_POSTHOG_HOST"
    : undefined;

// Analytics must never break the site, so an unconfigured build ships without
// PostHog. In development that would be easy to miss, so say it loudly.
if (missing && import.meta.env.DEV) {
  console.error(
    `${missing} variable required by PostHog is missing or un-configured, this causes events to be silently missed. This error stops appearing once ${missing} is configured`,
  );
}

// `null` leaves the inline script inert, so an unconfigured build still works.
const config = missing
  ? null
  : {
      token,
      options: {
        // `astro dev` has no Worker in front of it, so it talks to PostHog
        // directly.
        api_host: import.meta.env.DEV
          ? host
          : `${POSTHOG_PROXY_PATH}/${region}`,
        ui_host: `https://${region}.posthog.com`,
        defaults: "2026-05-30",
        // ClientRouter navigations are history changes, not page loads.
        capture_pageview: "history_change",
        // No cookies or browser storage, so the site needs no consent banner.
        cookieless_mode: "always",
      },
    };
---

<script is:inline define:vars={{ config }}>
  // @ts-nocheck -- `checkJs` would otherwise type-check PostHog's minified loader.
  // ClientRouter can re-run inline scripts; initialising twice overflows the
  // stack.
  if (config && !window.__posthog_initialized) {
    window.__posthog_initialized = true;
    // prettier-ignore
