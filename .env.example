# Copy to `.env`. Both are read at build time and are safe to expose: the
# project token ships in the page HTML. Without them the site builds and runs
# with analytics switched off.
PUBLIC_POSTHOG_PROJECT_TOKEN=
# The project lives on PostHog EU Cloud (US would be https://us.i.posthog.com).
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
